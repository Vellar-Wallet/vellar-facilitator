# Vellar x402 Facilitator — configuration
# Copy to .env and fill in. TESTNET ONLY until the security review (BUILD-PLAN Phase 3).

# REQUIRED: funded Stellar classic secret (S...). Settles payments and pays
# sponsored network fees. Use a dedicated account; never a mainnet key here.
SPONSOR_SECRET_KEY=

# Network: "testnet" (default) or "pubnet".
STELLAR_NETWORK=testnet

# Optional Soroban RPC override (defaults to the public testnet RPC).
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Fee ceiling in stroops for verify (default 2000000). Policy-governed
# smart-account payments cost ~140k; the @x402/stellar package default of
# 50000 rejects them — do not lower this below ~200000.
# MAX_TX_FEE_STROOPS=2000000

# Optional Bazaar catalog persistence file (in-memory only when unset).
# CATALOG_FILE=./data/bazaar-catalog.json

# Fix 1 — sponsorship spend control. ENFORCED on pubnet, log-only on testnet.
# Defaults are conservative placeholders; REVIEW before any pubnet traffic.
# Per-payTo settlement rate limit (default 30 settlements per 60s):
# SETTLE_RATE_MAX=30
# SETTLE_RATE_WINDOW_MS=60000
# Global rolling sponsor-spend ceiling (default 5 XLM = 50,000,000 stroops per
# 60s). Per-settle spend is estimated at MAX_TX_FEE_STROOPS (worst case), so
# accounting over-counts and the ceiling fails safe (bites earlier, not later):
# SPEND_CEILING_STROOPS=50000000
# SPEND_WINDOW_MS=60000

# PORT=4100
# HOST=0.0.0.0
