{
  "title": "Vellar Facilitator — Status",
  "uid": "vellar-facilitator-status",
  "tags": ["vellar", "tranche-1"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Settle success rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        {
          "expr": "rate(vellar_settle_total{outcome=\"success\"}[5m])",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }
        }
      ]
    },
    {
      "id": 2,
      "title": "Settle error breakdown",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        {
          "expr": "sum by (reason) (rate(vellar_settle_errors_total[5m]))",
          "refId": "A",
          "legendFormat": "{{reason}}",
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }
        }
      ]
    },
    {
      "id": 3,
      "title": "Settle latency p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 15 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(vellar_settle_duration_seconds_bucket[5m]))",
          "refId": "A",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }
        }
      ]
    },
    {
      "id": 4,
      "title": "Settle latency p50 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(vellar_settle_duration_seconds_bucket[5m]))",
          "refId": "A",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }
        },
        {
          "expr": "histogram_quantile(0.99, rate(vellar_settle_duration_seconds_bucket[5m]))",
          "refId": "B",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }
        }
      ]
    },
    {
      "id": 5,
      "title": "Channel pool health",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        {
          "expr": "vellar_pool_available",
          "refId": "A",
          "legendFormat": "available",
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }
        },
        {
          "expr": "vellar_pool_in_use",
          "refId": "B",
          "legendFormat": "in use",
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }
        },
        {
          "expr": "vellar_pool_disabled",
          "refId": "C",
          "legendFormat": "disabled",
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }
        }
      ]
    },
    {
      "id": 6,
      "title": "Verify volume",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(vellar_verify_total[5m]))",
          "refId": "A",
          "legendFormat": "{{outcome}}",
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }
        }
      ]
    },
    {
      "id": 7,
      "title": "Catalog size",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        {
          "expr": "vellar_catalog_size",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }
        }
      ]
    },
    {
      "id": 8,
      "title": "Rate limit rejections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" },
      "targets": [
        {
          "expr": "rate(vellar_rate_limit_rejections_total[5m])",
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "grafanacloud-prom" }
        }
      ]
    }
  ]
}
